diff --git a/aifeynman/S_gradient_decomposition.py b/aifeynman/S_gradient_decomposition.py
index 92c8842..91ec581 100644
--- a/aifeynman/S_gradient_decomposition.py
+++ b/aifeynman/S_gradient_decomposition.py
@@ -105,10 +105,10 @@ def score_consistency(grads_tensor):
     n_pts = grads_tensor.shape[0]
     grads_tensor = grads_tensor.cpu()
     norms = [np.linalg.norm(grads_tensor[i, :].numpy()) for i in range(n_pts)]
-    normalized_grads = [grads_tensor[i,:].numpy()/norms[i] for i in range(n_pts)]
+    normalized_grads = [grads_tensor[i,:].numpy()/max(norms[i], 1e-12) for i in range(n_pts)]  # local patch: avoid 0/0
     A = np.array(normalized_grads)
     D = np.einsum('ij,ik', A, A)
-    evals, evecs = np.linalg.eig(D)
+    evals, evecs = np.linalg.eigh(D)  # local patch: D = A^T A is symmetric; eig gave complex output that breaks scipy>=1.15 iqr
     nv = evals.shape[0]
     assert(nv == A.shape[1])
     # evecs should be d x (num eigenvectors - probably also d)
